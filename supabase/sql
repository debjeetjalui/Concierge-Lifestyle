/*
  # Disable Email Confirmation for Development

  This migration helps with development by ensuring users can sign in immediately
  after creating an account without needing to confirm their email.
  
  Note: In production, you may want to re-enable email confirmation for security.
*/

-- Update auth settings to disable email confirmation
-- Note: This needs to be done in the Supabase dashboard under Authentication > Settings
-- Set "Confirm email" to OFF for development

-- Alternatively, you can manually confirm existing users:
-- UPDATE auth.users SET email_confirmed_at = NOW() WHERE email_confirmed_at IS NULL;

-- Create a function to manually confirm users if needed
CREATE OR REPLACE FUNCTION public.confirm_user_email(user_email text)
RETURNS void AS $$
BEGIN
  UPDATE auth.users 
  SET email_confirmed_at = NOW() 
  WHERE email = user_email AND email_confirmed_at IS NULL;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;