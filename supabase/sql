  /*
  # Create experiences table

  1. New Tables
    - `experiences`
      - `id` (uuid, primary key)
      - `title` (text, experience name)
      - `category` (text, type of experience)
      - `location` (text, where it takes place)
      - `rating` (numeric, average rating)
      - `reviews` (integer, number of reviews)
      - `price` (text, price range indicator)
      - `image` (text, image URL)
      - `description` (text, detailed description)
      - `features` (text array, what's included)
      - `duration` (text, optional duration info)
      - `available_slots` (text array, available time slots)
      - `created_at` (timestamp)

  2. Security
    - Enable RLS on `experiences` table
    - Add policy for public read access to all experiences
    - Add policy for authenticated users to read experiences
*/

CREATE TABLE IF NOT EXISTS experiences (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  title text NOT NULL,
  category text NOT NULL,
  location text NOT NULL,
  rating numeric(2,1) DEFAULT 0.0,
  reviews integer DEFAULT 0,
  price text NOT NULL,
  image text NOT NULL,
  description text NOT NULL,
  features text[] DEFAULT '{}',
  duration text,
  available_slots text[] DEFAULT '{}',
  created_at timestamptz DEFAULT now()
);

ALTER TABLE experiences ENABLE ROW LEVEL SECURITY;

-- Allow public read access to experiences
CREATE POLICY "Anyone can read experiences"
  ON experiences
  FOR SELECT
  TO public
  USING (true);

-- Create indexes for better performance
CREATE INDEX IF NOT EXISTS idx_experiences_category ON experiences(category);
CREATE INDEX IF NOT EXISTS idx_experiences_rating ON experiences(rating DESC);
CREATE INDEX IF NOT EXISTS idx_experiences_created_at ON experiences(created_at DESC);

