  /*
  # Fix Email Confirmation and Profile Creation Issues

  1. Updates
    - Update RLS policies to handle profile creation during signup
    - Fix the trigger function to work with email confirmation flow
    - Add better error handling for profile creation
    - Ensure profiles are created even if email is not confirmed

  2. Security
    - Maintain secure RLS policies
    - Allow profile creation during the signup process
    - Handle both confirmed and unconfirmed users
*/

-- Drop existing policies and recreate them
DROP POLICY IF EXISTS "Users can insert own profile" ON profiles;
DROP POLICY IF EXISTS "Service role can insert profiles" ON profiles;

-- Allow authenticated users to insert their own profile
CREATE POLICY "Users can insert own profile"
  ON profiles
  FOR INSERT
  TO authenticated
  WITH CHECK (auth.uid() = id);

-- Allow the trigger function to insert profiles
CREATE POLICY "System can insert profiles"
  ON profiles
  FOR INSERT
  TO service_role
  WITH CHECK (true);

-- Update the trigger function to handle email confirmation better
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger AS $$
BEGIN
  -- Insert profile regardless of email confirmation status
  INSERT INTO public.profiles (id, email, full_name, preferences)
  VALUES (
    new.id, 
    new.email, 
    COALESCE(
      new.raw_user_meta_data->>'full_name', 
      split_part(new.email, '@', 1),
      'User'
    ),
    '{}'::text[]
  );
  RETURN new;
EXCEPTION
  WHEN unique_violation THEN
    -- Profile already exists, that's fine
    RETURN new;
  WHEN others THEN
    -- Log the error but don't fail the user creation
    RAISE LOG 'Error creating profile for user %: %', new.id, SQLERRM;
    RETURN new;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Ensure the trigger exists
DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;
CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();

-- Add a function to manually create missing profiles
CREATE OR REPLACE FUNCTION public.create_missing_profile(user_id uuid, user_email text, user_name text DEFAULT 'User')
RETURNS void AS $$
BEGIN
  INSERT INTO public.profiles (id, email, full_name, preferences)
  VALUES (user_id, user_email, user_name, '{}'::text[])
  ON CONFLICT (id) DO NOTHING;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

